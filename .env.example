# Copy to .env for local development. Never commit .env.

# HTTP server
DD_HTTP_ADDR=:8080
DD_HTTP_READ_TIMEOUT=30s
DD_HTTP_WRITE_TIMEOUT=0s
DD_HTTP_IDLE_TIMEOUT=120s
DD_HTTP_READ_HEADER_TIMEOUT=10s
DD_HTTP_SHUTDOWN_TIMEOUT=15s

# Logging
DD_LOG_LEVEL=info
DD_LOG_FORMAT=json

# Database
DD_DATABASE_PATH=./data/distributed-drive.db
DD_DATABASE_BUSY_TIMEOUT=5s
DD_DATABASE_MAX_OPEN_CONNS=1
DD_MIGRATE_ON_START=true

# --- Storage providers -------------------------------------------------------
# The node routes only appear when at least one provider is configured. Leave
# this whole block out and the service still runs pools and files, it just
# cannot register storage nodes.

# Encrypts every OAuth refresh token at rest. Required for the Google provider
# and never defaulted: a key that ships in the source protects nothing.
# Generate with: openssl rand -base64 32
DD_STORAGE_TOKEN_KEY=

# Where per-node encrypted tokens live. One file per node id.
DD_STORAGE_TOKEN_DIR=./data/tokens

# Google OAuth client. These are not secrets: a web client secret cannot be
# kept secret, and Google's own guidance is to embed it.
DD_STORAGE_GOOGLE_CLIENT_ID=
DD_STORAGE_GOOGLE_CLIENT_SECRET=

# Must match a redirect URI registered in the Google console.
# Leave empty for the loopback default (http://127.0.0.1:8080/oauth/callback).
DD_STORAGE_GOOGLE_REDIRECT_URI=

# Parent directory for local-filesystem nodes. A node's own directory is
# derived from its id, so a client cannot choose a path. Empty disables the
# localfs provider.
DD_STORAGE_LOCAL_NODE_ROOT=
